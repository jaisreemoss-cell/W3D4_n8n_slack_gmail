      "parameters": {
        "jsCode": "// Collect every row from Google Sheets\nconst rows = $input.all().map(item => item.json);\n\nconst date = new Date().toLocaleDateString('en-IN', {\n  day: '2-digit', month: 'short', year: 'numeric'\n});\nconst subject = `Latest Sheet Data – ${date}`;\n\n// No rows? Still send a clear email\nif (rows.length === 0) {\n  return [{ json: { subject, body: 'Hi,\\n\\nThe sheet has no data right now.\\n\\nRegards,\\nYour Automation Bot' } }];\n}\n\n// Use the sheet's column headers (skip n8n's internal row_number)\nconst headers = Object.keys(rows[0]).filter(h => h !== 'row_number');\n\n// One readable line per row: \"1. Name: Asha | City: Kochi\"\nconst lines = rows.map((row, i) =>\n  `${i + 1}. ` + headers.map(h => `${h}: ${row[h] ?? ''}`).join(' | ')\n);\n\nconst body =\n  `Hi,\\n\\n` +\n  `Here is the latest data from the sheet (${rows.length} rows):\\n\\n` +\n  `${lines.join('\\n')}\\n\\n` +\n  `Regards,\\nYour Automation Bot`;\n\nreturn [{ json: { subject, body } }];\n"
      },
