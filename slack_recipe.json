    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a cooking assistant that lists shopping items.\n\nRecipe: {{ $json.recipe }}\n\nList every product and ingredient needed to make this recipe.\n\nOutput rules (follow exactly):\n- Output ONLY the list. No title, no intro sentence, no headings, no closing remarks.\n- One line per item, each starting with \"- \".\n- Put the main ingredients first, then supporting ones. Related minor items may share a line (e.g. \"- Tomatoes, onions, cashews\").\n- No quantities, no cooking steps, no timings, no bold or other formatting.\n\nIf the text is not a recognisable dish or recipe, output exactly: INVALID",
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        832,
        224
      ],
