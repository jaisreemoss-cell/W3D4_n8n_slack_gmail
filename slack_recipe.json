      "name": "Basic LLM Chain"
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "gpt-4.1-mini"
        },
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.2,
      "position": [
        832,
        432
      ],
      "id": "2792ecac-2003-4ce3-bdf1-c0e85dcd63db",
      "name": "OpenAI Chat Model",
      "credentials": {
        "openAiApi": {
          "id": "PLP9metMhmALyTYU",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const recipe = $('Edit Fields').first().json.recipe;\n\nreturn $input.all().map(item => {\n  const raw = (item.json.text || '').trim();\n\n  // AI could not recognise the dish\n  if (!raw || /^INVALID\\b/i.test(raw)) {\n    return { json: { text: `Sorry, I couldn't recognise \"${recipe}\" as a recipe. Please send a dish name, e.g. Paneer Butter Masala.` } };\n  }\n\n  // Keep only list lines, strip any stray formatting, normalise to \"- item\"\n  const items = raw\n    .split('\\n')\n    .map(l => l.replace(/\\*\\*|__|`/g, '').trim())\n    .filter(l => /^([-*•]|\\d+[.)])\\s+/.test(l))\n    .map(l => '- ' + l.replace(/^([-*•]|\\d+[.)])\\s+/, '').trim())\n    .filter(l => l.length > 2);\n\n  const list = items.length ? items.join('\\n') : raw;\n  const text = `To make ${recipe} you'll need:\\n${list}`;\n  return { json: { text } };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
